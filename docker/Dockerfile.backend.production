FROM ghcr.io/astral-sh/uv:0.8.15 AS uv
FROM python:3.13-slim-bookworm

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --extra production

COPY backend ./backend
COPY database/schemas ./database/schemas
# COA master data only; operational exports and local database are not part of the image.
COPY database/raw_data/coa.csv database/raw_data/T_AKUN.csv database/raw_data/T_GOLKUN.csv database/raw_data/T_SUBGOL.csv ./database/raw_data/
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir -p /app/media /app/staticfiles \
    && chown -R app:app /app/media /app/staticfiles

USER app
WORKDIR /app/backend
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "120", "--no-control-socket", "--access-logfile", "-", "--error-logfile", "-"]
