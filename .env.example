# Database (PostgreSQL) — salin file ini menjadi .env lalu isi nilainya
DB_NAME=db_lebah_madu
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Django backend
DJANGO_SECRET_KEY=ganti-dengan-secret-acak-yang-panjang
DJANGO_DEBUG=true
DJANGO_ENV=development          # set 'production' saat deploy
DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS (frontend); pisahkan dgn koma
DJANGO_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Set true di PRODUKSI utk SSL redirect, HSTS, secure cookies
DJANGO_HTTPS=false
